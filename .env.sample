# Chép thành .env.local rồi sửa.
#
# Chỉ MỘT biến: gốc của backend. REST và WebSocket đều suy ra từ nó, lý do ghi
# trong src/lib/config.ts.

# Máy cá nhân — backend chạy bằng `npm run start:dev` bên Zoldify_Backend
NEXT_PUBLIC_API_ORIGIN=http://localhost:3000

# Production
# NEXT_PUBLIC_API_ORIGIN=https://api.zoldify.com
